# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=nutrition
POSTGRES_PASSWORD=nutrition_dev_pw
POSTGRES_DB=nutrition_mind

# ── 백엔드 (NestJS) ────────────────────────────────────────
JWT_SECRET=dev-jwt-secret-change-me
# 데모 계정은 npx prisma db seed로 생성됨 (admin/consultant/marketing@example.com — README 참조)

# ── 프론트엔드 (Next.js) ───────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# ── FastMCP 서버 ───────────────────────────────────────────
# 생성 예시(bash/zsh): openssl rand -hex 32
MCP_TOKEN=dev-mcp-token-change-me

# ── LLM 설정 (합성 단계용, 선택사항) ──────────────────────
# LLM_PROVIDER: openai | anthropic | ollama (미설정 시 openai로 동작)
# ollama 선택 시 LLM_API_KEY 불필요 (로컬 엔진), LLM_MODEL은 로컬 모델명
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Ollama 임베딩 ──────────────────────────────────────────
# 사전 준비: ollama pull qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024

# ── 공공데이터 API 키 ──────────────────────────────────────
LAW_OPEN_API_KEY=
FOODSAFETY_API_KEY=
