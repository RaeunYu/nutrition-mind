# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=nutrition
POSTGRES_PASSWORD=nutrition_dev_pw
POSTGRES_DB=nutrition_mind

# ── 백엔드 (NestJS) ────────────────────────────────────────
JWT_SECRET=dev-jwt-secret-change-me
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=demo1234

# ── 프론트엔드 (Next.js) ───────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# ── FastMCP 서버 ───────────────────────────────────────────
# 생성 예시(bash/zsh): openssl rand -hex 32
MCP_TOKEN=dev-mcp-token-change-me

# ── LLM API 키 (.env 직접 편집 또는 아래 셸 예시 사용) ─────
# bash/zsh:  echo 'OPENAI_API_KEY=sk-...' >> .env
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Ollama 임베딩 ──────────────────────────────────────────
# 사전 준비: ollama pull qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024

# ── 공공데이터 API 키 ──────────────────────────────────────
LAW_OPEN_API_KEY=
FOODSAFETY_API_KEY=
