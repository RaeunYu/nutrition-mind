// Prisma v7 스키마 — 기존 db/init/01_schema.sql에서 인트로스펙션하여 작성.
// v8 마이그레이션 계획은 prisma/V8_MIGRATION_NOTE.md 참고.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

/// 법령 조문 (조문 1개 = 청크 1개)
/// law_type: 'law' | 'enforcement_decree' | 'enforcement_rule' | 'administrative_rule' | 'referenced_external'
/// (DB에는 CHECK 제약으로 존재 — Prisma는 String으로 매핑)
model LegalProvision {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lawName           String   @map("law_name")
  lawType           String   @map("law_type")
  articleNo         String   @map("article_no")
  articleTitle      String?  @map("article_title")
  content           String
  promulgationDate  DateTime? @map("promulgation_date") @db.Date
  effectiveDate     DateTime? @map("effective_date") @db.Date
  /// qwen3-embedding:0.6b (dim=1024) — Prisma 미지원 타입, 원시 SQL로만 기록/조회
  embedding         Unsupported("vector(1024)")?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  referencesFrom ProvisionReference[] @relation("ProvisionReference_from")
  referencesTo   ProvisionReference[] @relation("ProvisionReference_to")

  @@unique([lawName, articleNo])
  @@index([lawName], map: "idx_legal_provisions_law")
  @@map("legal_provisions")
}

/// 조문 참조 관계 (위임/인용 엣지)
/// reference_type: 'delegates_to' | 'cites'
model ProvisionReference {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromId     String         @map("from_provision_id") @db.Uuid
  toId       String         @map("to_provision_id") @db.Uuid
  referenceType String      @map("reference_type")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  fromProvision LegalProvision @relation("ProvisionReference_from", fields: [fromId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  toProvision   LegalProvision @relation("ProvisionReference_to", fields: [toId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([fromId, toId, referenceType])
  @@map("provision_references")
}

/// 식약처 원시 데이터 (구조화 조회 소스)
/// 품목제조신고류(apiCode: C003·I0030)는 payload에서 정규화 칼럼으로 추출·백필됨 (이슈 #12).
/// 검색 인덱스(pg_trgm GIN)는 Prisma 미지원 ops — 수동 SQL로만 관리 (db/init/01_schema.sql 참고).
model FoodsafetyRow {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  apiCode   String   @map("api_code")
  payload   Json
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)
  /// 제품명 (PRDLST_NM)
  productName       String?  @map("product_name")
  /// 원료명 (RAWMTRL_NM)
  rawMaterialName   String?  @map("raw_material_name")
  /// 기능성 문구 (PRIMARY_FNCLTY)
  functionalityText String?  @map("functionality_text")
  /// 1일 섭취량·섭취 주의사항 (DAY_INTK_CN·NTK_MTHD 등, 이슈 #20)
  intakeNote        String?  @map("intake_note")
  /// 제조 업소명 (BSSH_NM, 이슈 #29)
  manufacturerName  String?  @map("manufacturer_name")
  /// 생산종료여부 (PRODUCTION: 예/아니오, 이슈 #29)
  productionEnded   String?  @map("production_ended")
  /// 신고번호 (PRDLST_REPORT_NO)
  reportNo          String?  @map("report_no")

  @@index([apiCode], map: "idx_foodsafety_rows_api")
  @@index([reportNo], map: "idx_foodsafety_rows_report_no")
  @@map("foodsafety_rows")
}

/// 증분 감지 기준 (total_count 기반)
model SyncState {
  apiCode   String   @id @map("api_code")
  totalCount BigInt  @default(0) @map("total_count")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("sync_state")
}

/// 역할 (간소화 RBAC — ADR-0001: Role 테이블 + 가드·데코레이터)
/// role_id: 'admin' | 'consultant' | 'marketing' (DB CHECK 제약으로 존재)
model Role {
  roleId String @id @map("role_id")
  label  String
  users  User[]

  @@map("roles")
}

/// 데모 사용자 (JWT 로그인)
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  roleId       String   @map("role_id")
  role         Role     @relation(fields: [roleId], references: [roleId])
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("users")
}

/// 고객 — 개인식별 필드는 envelope encryption(ADR-0002, 이슈 #13).
/// key_slot = 마스터 키(KEK)로 wrap한 고객별 데이터 키(DEK), *_enc = DEK로 암호화한 필드 암호문.
/// 저장 형식: v1:<nonce_b64>:<ciphertext+tag_b64> — 암호화 서비스(crypto.service)가 파싱.
/// 암호문은 nonce마다 달라지므로 DB UNIQUE·DB 정렬·DB 검색이 불가 → 서비스 레이어(복호화 비교)가 담당.
/// trgm/UNIQUE 같은 DB 인덱스는 암호문에 무의미 — 선언하지 않음.
model Customer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 고객 이름 — 식별 용이성 우선으로 평문 저장(이슈 #28 개정, ADR-0002 참조)
  name        String?
  keySlot     String   @map("key_slot")
  phoneEnc    String?  @map("phone_enc")
  emailEnc    String?  @map("email_enc")
  memoEnc     String?  @map("memo_enc")
  ingredients CustomerIngredient[]
  accessLogs  AccessLog[]
  intakeProducts CustomerProduct[]
  interests      CustomerInterest[]
  recommendations ProductRecommendation[]
  orders         Order[]

  @@map("customers")
}

/// 고객 섭취 제품 (이슈 #15) — 품목제조신고 제품 연결(source=foodsafety, 제품 정보 스냅샷 저장) 또는 수동 등록(source=manual).
/// 제품 데이터는 개인정보가 아니므로 평문 저장한다(ADR-0002는 개인식별 필드에만 적용).
model CustomerProduct {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  source       String
  apiCode      String?  @map("api_code")
  reportNo     String?  @map("report_no")
  productName  String   @map("product_name")
  rawMaterials String?  @map("raw_materials")
  functionality String? @map("functionality")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([customerId])
  @@map("customer_products")
}

/// 고객:성분 1:N
model CustomerIngredient {
  customerId     String @map("customer_id") @db.Uuid
  ingredientName String @map("ingredient_name")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([customerId, ingredientName])
  @@map("customer_ingredients")
}

/// 접근 로그 (ADR-0002, 이슈 #14) — 고객 개인정보 노출 화면 접근 기록(총관리자만 조회).
/// actor_email·actor_role은 접근 시점의 JWT 클레임(사용자 삭제 후에도 기록 유지 — 비정규화).
model AccessLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorEmail String   @map("actor_email")
  actorRole  String   @map("actor_role")
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  accessedAt DateTime @default(now()) @map("accessed_at") @db.Timestamptz(6)

  @@index([accessedAt(sort: Desc)])
  @@index([customerId])
  @@map("access_logs")
}

/// 성분 마스터 (이슈 #16) — 표준 성분명 + 동의어·키워드(쉼표 구분 텍스트).
/// 용어: 성분(표준화된 성분명) ≠ 원료(식약처 원재료명 텍스트) — 성분/원료 혼용 금지(CONTEXT.md).
/// 키워드 규칙 매핑은 서비스 레이어(ingredient-mapping.service)가 담당 — DB 인덱스 불필요.
model Ingredient {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  synonyms  String?
  keywords  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  interests CustomerInterest[]
  recommendations ProductRecommendation[]

  @@map("ingredients")
}

/// 관심 성분 (이슈 #16) — 담당자가 고객별로 지정한 목표 성분. (customer_id, ingredient_id) 유니크.
model CustomerInterest {
  customerId   String @map("customer_id") @db.Uuid
  ingredientId String @map("ingredient_id") @db.Uuid

  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([customerId, ingredientId])
  @@map("customer_interests")
}

/// 추천 제품 제안 (이슈 #17) — 성분 갭 기반 품목제조신고 제품 제안.
/// 담당자 확인 절차: status proposed →(수용) accepted | (보류) held, decided_at 기록 — 자동 확정 없음.
/// 제품 데이터는 개인정보가 아니므로 평문 저장(ADR-0002는 개인식별 필드에만 적용).
/// 동일 제안 중복 차단용 부분 유니크 인덱스(idx_product_recommendations_unique, WHERE api_code·report_no NOT NULL)
/// 는 Prisma 미지원 ops — 수동 SQL로만 관리(db/init/01_schema.sql·db/migrations 참고. #15 customer_products 선례).
/// status: 'proposed' | 'accepted' | 'held' (DB CHECK 제약으로 존재 — Prisma는 String으로 매핑)
model ProductRecommendation {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String     @map("customer_id") @db.Uuid
  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ingredientId  String     @map("ingredient_id") @db.Uuid
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  apiCode       String?    @map("api_code")
  reportNo      String?    @map("report_no")
  productName   String     @map("product_name")
  rawMaterials  String?    @map("raw_materials")
  manufacturerName String? @map("manufacturer_name")
  productionEnded String?  @map("production_ended")
  ingredientName String    @map("ingredient_name")
  evidenceKeyword String   @map("evidence_keyword")
  status        String     @default("proposed")
  decidedAt     DateTime?  @map("decided_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([customerId], map: "idx_product_recommendations_customer")
  @@index([ingredientId], map: "idx_product_recommendations_ingredient")
  @@map("product_recommendations")
}

// ─────────────────────────────────────────────────────────────────────────────
// 상거래 도메인 (Epic #3, ADR-0003) — 상담 담당자의 주문·결제·배송 문의를
// 도구가 조회하는 근거. 용어는 CONTEXT.md(주문·주문 항목·결제·배송·배송 이력·운송장)를 따른다.
// 상태값은 영문 코드로 저장하고 사용자 노출 문구는 도구/화면 계층에서 한국어로 변환한다.
// 코드값 CHECK 제약은 Prisma 미표현 DDL — 수동 마이그레이션 SQL에 존재(기존 테이블과 동일).
// ─────────────────────────────────────────────────────────────────────────────

/// 주문 — 고객이 접수한 구매 건. 상태: 'pending_payment'|'paid'|'preparing'|'shipping'|'delivered'|'cancelled'
model Order {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNo     String   @unique @map("order_no")
  customerId  String   @map("customer_id") @db.Uuid
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// 주문 상태(결제대기/결제완료/상품준비/배송중/배송완료/취소)
  status      String
  orderedAt   DateTime @map("ordered_at") @db.Timestamptz(6)
  /// 결제 통화는 원(KRW) — 정수 원 단위
  totalAmount Int      @map("total_amount")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  items     OrderItem[]
  payment   Payment?
  shipments Shipment[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

/// 주문 항목 — 주문에 포함된 개별 제품 줄. I0030 품목제조신고 제품을 참조하고 주문 시점 스냅샷을 저장한다(#15 패턴).
model OrderItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  apiCode      String?  @map("api_code")
  reportNo     String?  @map("report_no")
  productName  String   @map("product_name")
  rawMaterials String?  @map("raw_materials")
  quantity     Int      @default(1)
  unitAmount   Int      @map("unit_amount")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([reportNo])
  @@map("order_items")
}

/// 결제 — 주문 대금 지급 상태. 주문과 1:1. 상태: 'paid'|'failed'|'refunded'
model Payment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String    @unique @map("order_id") @db.Uuid
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// 결제 상태(결제완료/결제실패/환불완료)
  status       String
  /// 표시용 결제 수단 코드: 'card'|'bank_transfer'|'point'
  method       String
  amount       Int
  paidAt       DateTime? @map("paid_at") @db.Timestamptz(6)
  failedReason String?   @map("failed_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status])
  @@map("payments")
}

/// 배송 — 주문 항목이 고객에게 발송되는 단위. 하나의 주문이 여러 배송으로 나뉠 수 있다(부분배송).
/// 상태: 'ready'|'collected'|'in_transit'|'delivered'|'delayed'|'failed'
model Shipment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// 배송 상태(준비/집화완료/배송중/배송완료/배송지연/배송실패)
  status      String
  /// 택배사
  carrier     String?
  /// 운송장 번호
  trackingNo  String?   @map("tracking_no")
  /// 약속 배송일 — 배송 지연 판단 기준
  promisedAt  DateTime? @map("promised_at") @db.Timestamptz(6)
  shippedAt   DateTime? @map("shipped_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  events ShipmentEvent[]

  @@index([orderId])
  @@index([status])
  @@map("shipments")
}

/// 배송 이력 — 배송의 시간순 상태 변화. 배송 지연 여부를 판단하는 근거가 된다.
model ShipmentEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId String   @map("shipment_id") @db.Uuid
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     String
  location   String?
  note       String?
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}
